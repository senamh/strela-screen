{
  "manifest_version": 3,
  "name": "Strela Screen",
  "description": "Turn screen recordings into beautiful demos.",
  "version": "0.1.0",
  "action": {
    "default_title": "Strela Screen",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["desktopCapture", "offscreen", "downloads", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "109"
}
