{
  "manifest_version": 3,
  "name": "Strela Screen",
  "version": "0.5.0",
  "description": "Turn screen recordings into phone-ready demos with automatic focus, a smooth camera and local MP4 export. Nothing is uploaded.",
  "homepage_url": "https://github.com/senamh/strela-screen",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Strela Screen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
